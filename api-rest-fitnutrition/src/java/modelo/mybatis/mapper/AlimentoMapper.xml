<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="alimento">
    <!-- T321: Registrar nuevo alimento -->
    <insert id="registrarAlimento" parameterType="pojo.Alimento" useGeneratedKeys="true" keyProperty="idAlimento">
        INSERT INTO alimento (nombre_alimento, porcion, calorias_porcion)
        VALUES (#{nombreAlimento}, #{porcion}, #{caloriasPorcion})
    </insert>

</mapper>